# App
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3002

# Database
DATABASE_URL=postgresql://guettgui:guettgui@localhost:5434/guettgui_db

# Auth — JWT
JWT_SECRET=change-me-to-a-256-bit-random-secret
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=change-me-to-another-256-bit-random-secret
JWT_REFRESH_EXPIRES_IN=30d

# Relayio (OTP + WhatsApp)
RELAYIO_API_URL=https://api.relayio.com
RELAYIO_API_KEY=your-relayio-api-key

# Firebase (FCM)
FIREBASE_PROJECT_ID=guettgui-prod
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=your-firebase-client-email

# MinIO Object Storage (S3 compatible)
STORAGE_ENDPOINT=http://localhost:9002
STORAGE_ACCESS_KEY=guettgui
STORAGE_SECRET_KEY=guettgui123
STORAGE_BUCKET_NAME=guettgui
STORAGE_PUBLIC_URL=http://localhost:9002
STORAGE_FORCE_PATH_STYLE=true

# Throttle
THROTTLE_TTL=60
THROTTLE_LIMIT=100
OTP_THROTTLE_TTL=900
OTP_THROTTLE_LIMIT=5
